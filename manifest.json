{
  "manifest_version": 3,
  "name": "Python 알고리즘",
  "version": "2.0.0",
  "description": "Python 알고리즘 자동 제출 (GitHub OAuth) - 393문제",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://school.programmers.co.kr/*",
    "https://api.github.com/*",
    "https://github.com/login/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Python 알고리즘",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://school.programmers.co.kr/learn/courses/*/lessons/*"],
      "js": ["injected-programmers.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://school.programmers.co.kr/learn/courses/*/lessons/*"],
      "js": ["problems.js", "content-programmers.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/login/device*"],
      "js": ["content-github-device.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "114"
}
